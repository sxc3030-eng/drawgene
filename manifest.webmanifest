{
 "name": "drawGene",
 "short_name": "drawGene",
 "description": "Dessin technique 2D/3D, plans de maison et calcul de matériaux",
 "start_url": "plan.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#15171c",
 "theme_color": "#14315c",
 "lang": "fr",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "file_handlers": [
  {
   "action": "plan.html",
   "accept": {
    "application/x-drawgene": [
     ".drawgene"
    ]
   },
   "icons": [
    {
     "src": "icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ],
   "launch_type": "single-client"
  }
 ]
}